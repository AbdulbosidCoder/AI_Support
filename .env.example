# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram group id where escalations go to human support (operators reply to the bot's post).
# A group id starts with -100. Your own user id also works for testing alone: reply to the escalation post.
SUPPORT_CHAT_ID=
# A new conversation goes to a free operator first (once operators are added in the admin bot).
# If all are busy or the operator does not answer in OPERATOR_WAIT_SECONDS, the AI takes over. 0 = AI first.
# OPERATOR_FIRST=1
# OPERATOR_WAIT_SECONDS=60
# Conversations one operator handles at once, and minutes of silence after which a conversation stops keeping them busy
# OPERATOR_MAX_SESSIONS=1
# OPERATOR_IDLE_MINUTES=30
# A conversation nobody wrote in for this long is closed: the client rates the service, the operator and the AI assess the client. 0 = off
# SESSION_IDLE_MINUTES=30
# Anthropic API key for Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Speech-to-text (Whisper-compatible endpoint). Leave the key empty to ask clients to type instead.
STT_API_URL=https://api.openai.com/v1/audio/transcriptions
STT_API_KEY=
STT_MODEL=whisper-1
# SQLite file with clients, escalations, operator replies and approved answers (in Docker: the bot-data volume)
# DB_PATH=data/db/bot.sqlite3

# --- Admin bot and web panel (python -m ai_support.admin, docker compose service "admin") ---
# Token of a SEPARATE bot from @BotFather (not the client bot). Empty: the admin side stays off.
ADMIN_BOT_TOKEN=
# Telegram user ids of admins, comma separated. The admin bot tells anyone else their id.
ADMIN_IDS=
# Public hostname of the panel, routed by the Cloudflare Tunnel to http://admin:8080
ADMIN_DOMAIN=
# ADMIN_PORT=8080
# --- Support team's CRM: read-only chats by API token (tokens: python -m ai_support.admin.crm create "CRM") ---
# Sites allowed to show the chats page (https://ADMIN_DOMAIN/crm/) in an iframe, space separated. Empty: nobody.
# CRM_FRAME_ANCESTORS=https://crm.example.uz
# Requests per minute per token
# CRM_RATE_PER_MINUTE=120
# Take the caller's address from Cloudflare's CF-Connecting-IP (for token IP allow-lists); 0 behind another proxy
# CRM_TRUST_PROXY=1
# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel > the token in the install command)
CLOUDFLARE_TUNNEL_TOKEN=
# auto | http2 | quic; use http2 if the tunnel log shows "failed to dial ... 7844"
# TUNNEL_TRANSPORT_PROTOCOL=auto
