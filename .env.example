# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram group/chat id where escalations go to human support (operators reply to the bot's post)
SUPPORT_CHAT_ID=
# Anthropic API key for Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Speech-to-text (Whisper-compatible endpoint). Leave the key empty to ask clients to type instead.
STT_API_URL=https://api.openai.com/v1/audio/transcriptions
STT_API_KEY=
STT_MODEL=whisper-1
