# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram group id where escalations go to human support (operators reply to the bot's post).
# A group id starts with -100. Your own user id also works for testing alone: reply to the escalation post.
SUPPORT_CHAT_ID=
# Anthropic API key for Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Speech-to-text (Whisper-compatible endpoint). Leave the key empty to ask clients to type instead.
STT_API_URL=https://api.openai.com/v1/audio/transcriptions
STT_API_KEY=
STT_MODEL=whisper-1
# SQLite file with clients, escalations, operator replies and approved answers (in Docker: the bot-data volume)
# DB_PATH=data/db/bot.sqlite3
